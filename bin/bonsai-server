#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Starts the model MODEL names (Ternary-Bonsai-2-27B by default) on the llama.cpp tree its model
# file pins, with the settings from config.env, the profile and models/$MODEL.env.
# Extra arguments go straight to llama-server and override the defaults. Rationale: docs/dev.md.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$ROOT/config.env"

[[ -x "$LLAMA_SERVER" ]] || { echo "llama-server not found at $LLAMA_SERVER - run ./install.sh" >&2; exit 1; }
[[ -f "$MODEL_PATH" ]] || { echo "model not found at $MODEL_PATH - run ./install.sh model" >&2; exit 1; }

# A prebuilt llama.cpp may need its runtime on the library path; see config.env.
if [[ -n "$LLAMA_LIB_PATH" ]]; then export LD_LIBRARY_PATH="$LLAMA_LIB_PATH${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; fi

if [[ "$BACKEND" == vulkan ]]; then
  # RADV puts buffers in GTT although VRAM is free; this keeps the compute buffer in VRAM,
  # worth 1.22x on this model. Needs Mesa >= 25.2, silently ignored below.
  # See docs/dev.md#other-gpu-backends.
  export RADV_PERFTEST="${RADV_PERFTEST:-nogttspill}"
  # Without Resizable BAR only 256 MiB of VRAM are CPU-visible, and llama.cpp puts buffers there
  # that the host then writes directly: Qwen's checkpoint restores moved them to GTT, 2.3x slower
  # from the second request on. Off, writes go through a staging copy; Bonsai measures the same.
  # See docs/qwen.md#on-the-rx-570-vulkan.
  export GGML_VK_DISABLE_HOST_VISIBLE_VIDMEM="${GGML_VK_DISABLE_HOST_VISIBLE_VIDMEM:-1}"
fi

if [[ "$PRESERVE_THINKING" == "true" ]]; then
  PRESERVE_THINKING_FLAG=--reasoning-preserve
else
  PRESERVE_THINKING_FLAG=--no-reasoning-preserve
fi

args=(-m "$MODEL_PATH"
  --host "$LISTEN_HOST" --port "$PORT" --alias "$MODEL_ALIAS"
  -c "$CTX" -ngl 99 --fit off -fa on)
# A MoE model keeps the experts of CPU_MOE layers in RAM, and reads prompts at ~250 tok/s with
# the default ubatch of 512 against ~1 050 at 4096. Both set by its profile. See docs/qwen.md.
if [[ -n "$CPU_MOE" ]]; then args+=(--n-cpu-moe "$CPU_MOE"); fi
if [[ -n "$UB" ]]; then args+=(-b "$UB" -ub "$UB"); fi
args+=(--cache-type-k "$KV_K" --cache-type-v "$KV_V"
  --parallel 1 --no-context-shift
  --jinja --reasoning on)
if [[ -n "$EFFORT" ]]; then args+=(--reasoning-effort "$EFFORT"); fi
args+=(--reasoning-budget "$BUDGET" --reasoning-budget-message "$BUDGET_MSG"
  "$PRESERVE_THINKING_FLAG")
if [[ -n "$SPEC_TYPE" ]]; then args+=(--spec-type "$SPEC_TYPE"); fi
if [[ -n "$SERVER_ARGS" ]]; then read -ra extra <<<"$SERVER_ARGS"; args+=("${extra[@]}"); fi
args+=(--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0)

exec "$LLAMA_SERVER" "${args[@]}" "$@"
