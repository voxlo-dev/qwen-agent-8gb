#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Starts the pinned pi with its own config in PI_AGENT_DIR, set up for bonsai-server.
# A global pi and ~/.pi are not used. Arguments go straight to pi.
# With SERVER_AUTOSTART, starts bonsai-server in the background when none is running and stops it
# once the last bonsai-pi session ends - only for a server on this machine; a remote SERVER_HOST
# is expected to be serving already. Rationale: docs/agent.md#server-lifecycle.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$ROOT/config.env"

say() { printf '\033[1;36m==>\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

# A server that fails to start says why in its log, and nobody reads a log they are only pointed
# at. The usual causes are in docs/setup.md#troubleshooting: VRAM held by something else, a stale
# process on PORT, a model file that is not there.
die_with_log() {
  printf '\033[1;31mxx\033[0m %s\n' "$1" >&2
  if [[ -s "$SERVER_LOG" ]]; then
    printf '\n--- last 20 lines of %s ---\n' "$SERVER_LOG" >&2
    tail -20 "$SERVER_LOG" >&2
    printf -- '--- end ---\n\n' >&2
  fi
  printf 'Troubleshooting: docs/setup.md#troubleshooting\n' >&2
  exit 1
}

[[ -x "$PI_BIN" ]] || die "pi not found at $PI_BIN - run ./install.sh pi"

url="$SERVER_URL"
healthy() { curl -sf -o /dev/null --max-time 2 "$url/health"; }
alive()   { [[ -n "${1:-}" ]] && kill -0 "$1" 2>/dev/null; }

# Starting and stopping only makes sense for a server this script can own: a pid to signal and
# a log to read. A remote one is somebody else's process, so autostart steps aside for it.
case "$SERVER_HOST" in
  127.0.0.1 | ::1 | localhost)
    autostart="$SERVER_AUTOSTART"
    ;;
  *)
    autostart=false
    if [[ "$SERVER_AUTOSTART" == "true" ]]; then
      say "SERVER_HOST is $SERVER_HOST, not this machine - expecting a server there, starting none"
    fi
    ;;
esac

# Sessions register under run/, guarded by a lock, so a second bonsai-pi shares the server and
# only the last one to leave stops it. server.pid exists only for a server bonsai-pi started.
run="$BONSAI_HOME/run"
mkdir -p "$run/sessions"
exec 9>"$run/lock"

# Sessions whose process is gone: killed with SIGKILL, or the terminal closed hard, so their
# trap never ran. Pruned on both ends, which is what lets an orphaned server be adopted.
prune() { for f in "$run/sessions"/*; do [[ -e "$f" ]] && ! alive "${f##*/}" && rm -f "$f"; done; return 0; }

cleanup() {
  flock 9
  rm -f "$run/sessions/$$"
  prune
  local pid; pid="$(cat "$run/server.pid" 2>/dev/null || true)"
  if [[ -z "$(ls -A "$run/sessions")" ]] && alive "$pid"; then
    say "stopping bonsai-server"
    kill "$pid"
    for _ in {1..20}; do alive "$pid" || break; sleep 0.5; done
    alive "$pid" && kill -9 "$pid"
  fi
  alive "$pid" || rm -f "$run/server.pid"
  flock -u 9
}

if [[ "$autostart" == "true" ]]; then
  flock 9
  prune
  touch "$run/sessions/$$"
  trap cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 143' TERM
  trap 'exit 130' INT
  trap 'exit 131' QUIT
  # A server left behind by a session that died without its trap (see docs/agent.md#server-lifecycle)
  # is adopted here: its pid stays in server.pid, so this session stops it when it leaves.
  pid="$(cat "$run/server.pid" 2>/dev/null || true)"
  if ! healthy && ! alive "$pid"; then
    say "starting bonsai-server in the background, log: $SERVER_LOG"
    # Own session: Ctrl+C in pi must not reach the server, and closing the terminal is
    # handled by the HUP trap above instead of killing it behind our back.
    setsid "$ROOT/bin/bonsai-server" >"$SERVER_LOG" 2>&1 </dev/null 9>&- &
    pid=$!
    echo "$pid" > "$run/server.pid"
  fi
  flock -u 9

  if ! healthy; then
    say "waiting for the model to load"
    for ((i = 0; i < SERVER_START_TIMEOUT; i++)); do
      healthy && { say "server ready after ${i}s, starting pi"; break; }
      alive "$pid" || die_with_log "bonsai-server exited during start"
      # The model takes a while; say so once instead of leaving a silent terminal.
      ((i == 30)) && say "still loading (${CTX} token window on $BACKEND); the timeout is ${SERVER_START_TIMEOUT}s"
      sleep 1
    done
    healthy || die_with_log "bonsai-server not ready after ${SERVER_START_TIMEOUT}s - raise SERVER_START_TIMEOUT if the model is on a slow disk"
  fi
fi

# With two models, the server on PORT may be the other one: reused as healthy above, it would
# answer pi under the wrong name. Say which it is instead of starting pi against it.
models="$(curl -sf --max-time 2 "$url/v1/models" || true)"
if ! grep -q "\"$MODEL_ALIAS\"" <<<"$models"; then
  served="$(grep -o '"id" *: *"[^"]*"' <<<"$models" | head -1 | sed 's/.*"\([^"]*\)"$/\1/' || true)"
  [[ -n "$served" ]] && die "the server at $url serves $served, not $MODEL_ALIAS (MODEL=$MODEL) - stop it, or give one of them another PORT"
  die "no bonsai-server with model $MODEL_ALIAS at $url - start bonsai-server, or set SERVER_AUTOSTART=true"
fi

# pi handles Ctrl+C itself. Uncaught, SIGINT would also end this script without its EXIT trap;
# caught, bash resets it for pi, which still gets it as usual.
trap : INT
status=0
# The localagent extension reads its limits from the environment, so config.env stays the source.
export LOCALAGENT_MAX_TURNS="$AGENT_MAX_TURNS" LOCALAGENT_AGENT_MODEL="local/$AGENT_MODEL_ID"
PI_CODING_AGENT_DIR="$PI_AGENT_DIR" "$PI_BIN" "$@" 9>&- || status=$?
exit "$status"
