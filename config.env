# SPDX-License-Identifier: MIT
# Settings shared by the install scripts and the qwen-* commands. A variable already set in the
# environment wins.

# Install location: builds, models, pi and its configs, ~120 GB with all three models. An install
# from before the rename (BONSAI_HOME set, or the old default directory present) keeps its place:
# nothing is moved, nothing downloaded again.
if [ -z "${QWEN_HOME:-}" ]; then
  if [ -n "${BONSAI_HOME:-}" ]; then QWEN_HOME="$BONSAI_HOME"
  elif [ -d "$HOME/.local/share/bonsai-local" ]; then QWEN_HOME="$HOME/.local/share/bonsai-local"
  else QWEN_HOME="$HOME/.local/share/qwen-local"
  fi
fi

# Model, by the system RAM next to the 8 GB card: "bonsai" (Ternary-Bonsai-2-27B, all on the card,
# simple tasks), "qwen36-35b" (Qwen3.6-35B-A3B, experts in ~24 GB of RAM, the default and the
# recommendation from 32 GB) or "qwen38-flash" (Qwen3.8-Flash-Next, 125B, every expert in RAM,
# from 64 GB; the strongest, experimental). The environment wins, then the choice install.sh wrote
# to $QWEN_HOME/model.env, then the default. models/$MODEL.env pins the GGUF, the llama.cpp tree
# that runs it and the flags that differ between them. See README.md#which-model.
MODEL_DEFAULT=qwen36-35b
MODEL_FROM=env
if [ -z "${MODEL:-}" ]; then
  MODEL_FROM=default
  if [ -f "$QWEN_HOME/model.env" ]; then . "$QWEN_HOME/model.env"; MODEL_FROM=file; fi
  : "${MODEL:=$MODEL_DEFAULT}"
fi
_root="$(dirname "${BASH_SOURCE[0]}")"
[ -f "$_root/models/$MODEL.env" ] || { echo "unknown MODEL '$MODEL' - see models/" >&2; return 1 2>/dev/null || exit 1; }

# Context profile: "dedicated" (GPU drives no display) or "display" (GPU also renders a desktop).
# It sets CTX and the four budget values, which constrain each other - see the block below and
# docs/agent.md#context-budget - and can set anything the model file declares, since it is read
# first. Switch with PROFILE=display, and re-run ./install.sh pi after.
: "${PROFILE:=dedicated}"
_profile_file="$_root/profiles/$MODEL/$PROFILE.env"
[ -f "$_profile_file" ] || { echo "unknown PROFILE '$PROFILE' for MODEL '$MODEL' - see profiles/$MODEL/" >&2; return 1 2>/dev/null || exit 1; }

# GPU backend: "cuda" (NVIDIA, the measured default) or "vulkan" (AMD through RADV, ~5x slower,
# for batch use). It selects the toolchain deps installs, the flags build passes and the patches
# the model file names (PATCH_DIR, patches/$BACKEND for the fork). Switch with BACKEND=vulkan
# ./install.sh; build rebuilds by itself when the backend or the patch set changes. See
# docs/bonsai.md#other-gpu-backends.
: "${BACKEND:=cuda}"
case "$BACKEND" in cuda|vulkan) ;; *) echo "unknown BACKEND '$BACKEND' (cuda, vulkan)" >&2; return 1 2>/dev/null || exit 1 ;; esac

# A backend can override part of the profile in profiles/$MODEL/$PROFILE-$BACKEND.env, read before
# it so its values win. Only where a backend measured differently: Qwen on Vulkan (docs/qwen36.md).
_backend_file="$_root/profiles/$MODEL/$PROFILE-$BACKEND.env"
if [ -f "$_backend_file" ]; then . "$_backend_file"; fi
. "$_profile_file"
. "$_root/models/$MODEL.env"
LLAMA_SERVER="$LLAMA_DIR/build/bin/llama-server"
# A tree whose commit cannot be fetched comes as a release tarball instead: LLAMA_TARBALL is its
# URL, LLAMA_TARBALL_SHA256 the pin build checks it against. Only Unsloth's, the Qwen tree on CUDA.
: "${LLAMA_TARBALL:=}"
: "${LLAMA_TARBALL_SHA256:=}"
# Further cmake flags the tree needs, word-split, set by the model file. Part of the build stamp, so
# a change rebuilds. Only Unsloth's tree on CUDA has one: CCCL 3.2 (docs/qwen38-flash.md, T-049).
: "${LLAMA_CMAKE_ARGS:=}"
MODEL_PATH="$QWEN_HOME/models/$MODEL_FILE"
# Set by a MoE model's profile only; empty means the flag is not passed. See bin/qwen-server.
: "${CPU_MOE:=}"
: "${UB:=}"
# Further llama-server flags a model file needs and no setting above covers, word-split. Empty for
# Bonsai and Qwen3.6; Qwen3.8-Flash keeps its experts file-backed with them. See its model file.
: "${SERVER_ARGS:=}"

# CUDA architecture to compile for, e.g. 89 for an RTX 40xx. Empty means the card nvidia-smi
# reports, or cmake's "native" without one; set it to build where the card is not visible.
: "${CUDA_ARCH:=}"

# Parallel compile jobs. Empty means derive them: one per core, but capped so each job has
# ~2 GB, because a single Vulkan shader unit peaks at 4.4 GB and -j nproc can put several
# heavy ones side by side. Set a number to override. See docs/setup.md#ram-and-build-memory.
: "${BUILD_JOBS:=}"

# pi, a private instance: pinned version, own config dir, ~/.pi is never touched.
# The context budget below was measured against this version's compaction code.
: "${PI_VERSION:=0.85.1}"
: "${PI_PREFIX:=$QWEN_HOME/pi}"
# One config dir per model, since the compaction keys in settings.json apply to the whole dir.
# Bonsai keeps the original name, so an existing install keeps its sessions.
_pi_agent="pi-agent"; [ "$MODEL" = bonsai ] || _pi_agent="pi-agent-$MODEL"
: "${PI_AGENT_DIR:=$QWEN_HOME/$_pi_agent}"
PI_BIN="$PI_PREFIX/node_modules/.bin/pi"

# qwen-pi starts qwen-server when none answers at SERVER_URL and stops it after its last
# session. A server started by hand is used as is and never stopped. Only a server on this
# machine can be started this way: with a remote SERVER_HOST there is no process to manage, so
# autostart is skipped and the server is expected to be running already.
: "${SERVER_AUTOSTART:=true}"
: "${SERVER_LOG:=$QWEN_HOME/server.log}"
: "${SERVER_START_TIMEOUT:=300}"

# bin/qwen-studio opens the same model and flags in Unsloth Studio through its `unsloth`
# command. Studio serves on its own port (8888), with its own login. See docs/agent.md#unsloth-studio.
: "${UNSLOTH_CLI:=$HOME/.unsloth/studio/unsloth_studio/bin/unsloth}"

# Server. LISTEN_HOST is the address the server binds to, SERVER_HOST the one qwen-pi and pi
# connect to: the same machine by default, different ones when the server runs elsewhere. A
# remote server needs LISTEN_HOST=0.0.0.0 on its side and has no authentication - see
# docs/agent.md#a-server-on-another-machine. Re-run ./install.sh pi after changing either of these.
: "${LISTEN_HOST:=127.0.0.1}"
: "${SERVER_HOST:=127.0.0.1}"
: "${PORT:=8080}"
SERVER_URL="http://$SERVER_HOST:$PORT"
# BUDGET_MSG closes a thinking block cut off at BUDGET. One step, not "the files": in the T-019
# Tron run the orchestrator read "write the files" as leave to write a test file next to its plan.
_budget_msg=$'\n\nThinking budget reached. Stop planning and act now: make your next tool call.\n'
: "${BUDGET_MSG:=$_budget_msg}"

# The localagent workflow's agents (qwen-pi --localagent). AGENT_BUDGET is the per-turn thinking
# budget a dispatched agent runs with, sent per request; the orchestrator keeps BUDGET. At BUDGET
# a child's thinking alone crosses pi's compaction trigger in five turns, since every turn of a
# tool loop stays in the prompt. AGENT_MAX_TURNS ends a dispatch as BLOCKED, a backstop against a
# runaway (332 turns in the Tron run), set well above what a unit takes (10-16 turns): at 15 it
# cut off three dispatches that were done or one step from it. It appears in no prompt, since this
# model checks a stated limit with turns. Both feed qwen-pi; AGENT_BUDGET also needs ./install.sh pi.
# Rationale and the run behind it: docs/localagent.md#economics.
: "${AGENT_BUDGET:=4096}"
_agent_budget_msg=$'\n\nThinking budget reached. Do not plan further: take the next concrete step with a tool call now, and write files with what you have. You can refine them next turn.\n'
: "${AGENT_BUDGET_MSG:=$_agent_budget_msg}"
: "${AGENT_MAX_TURNS:=30}"

# Seconds after which a bash call the model starts without a timeout of its own is ended, through
# the tool-timeout extension (qwen-pi exports it). pi has no default: a server started in the
# foreground holds the session until someone aborts it. Of 534 tool calls in the Tron sessions on
# the 4060 Ti machine none that finished took longer than 3.8 min; the 4 that hung were aborted by
# hand at 5-15 min. 0 turns it off. See docs/agent.md#tool-timeout.
: "${TOOL_TIMEOUT:=300}"
AGENT_MODEL_ID="$MODEL_ALIAS-agent"

# Drop the thinking of earlier turns from the rendered prompt; the current turn keeps its own.
# The template preserves all of it unless told otherwise. See docs/bonsai.md#thinking-in-the-prompt.
: "${PRESERVE_THINKING:=false}"

# CTX, BUDGET, MAX_TOKENS, RESERVE_TOKENS and KEEP_RECENT_TOKENS come from the profile above.
# They must satisfy:
#   RESERVE_TOKENS >= the largest single turn's output, and CTX - RESERVE_TOKENS + MAX_TOKENS <= CTX
#   KEEP_RECENT_TOKENS well below CTX - RESERVE_TOKENS, or pi compacts on every turn.
#   BUDGET + a tool call <= RESERVE_TOKENS - 4096: pi clamps max_tokens by that near the trigger.
# Rationale and measurements: docs/agent.md#context-budget.
