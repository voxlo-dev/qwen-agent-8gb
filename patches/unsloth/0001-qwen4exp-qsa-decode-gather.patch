From c3c8d87cb137cf0a6a092c2c88c9d1de222bc991 Mon Sep 17 00:00:00 2001
From: voxlo-dev <125759415+voxlo-dev@users.noreply.github.com>
Date: Fri, 16 Oct 2026 17:17:30 +0200
Subject: [PATCH 1/2] qwen4exp: attend over the gathered top-k cells at decode
 on a quantized cache

build_attn_qsa turns the indexer's top-k into a -inf mask over the whole
cache and runs flash attention over every cell. For a single query on a
quantized cache the CUDA backend picks the vector kernel, which reads all
n_kv cells per token: the MMA kernel's own sparse gather only applies to
f16 K/V, since it would convert the whole cache to f16 first.

At decode (one token, one stream, flash attention on, a quantized K or V,
top-k padded to 256 below n_kv), get_rows the top-k cells of K, V and the
query's mask row, pad to a whole FATTN_KQ_STRIDE with zero cells masked
-inf, and attend over those. Every other case takes the masked path as
before.

Qwen3.8-Flash-Next UD-IQ4_XS, RTX 4060 Ti 8 GB, q8_0/q8_0 at 131k: flash
attention per token at 64k of depth 10.6 -> ~0.3 ms, GPU time per token
42.4 -> 33.5 ms, decode 11.7 -> 13.1 tok/s. Prefill unchanged.
---
 src/models/qwen4exp.cpp | 51 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 79801e3..0b0440b 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -949,6 +949,57 @@ ggml_tensor * llama_model_qwen4exp::graph::build_attn_qsa(
 
     ggml_tensor * kq_mask = inp->get_kq_mask();
 
+    // decode on a quantized cache: gather the top-k cells and attend over those alone. The masked
+    // path below reads every cell of the cache per token (the vector kernel takes it for a single
+    // query), and the MMA kernel's own sparse gather needs f16: it converts the whole cache first.
+    {
+        ggml_tensor * k = mctx_cur->get_k(ctx0, il);
+        ggml_tensor * v = mctx_cur->get_v(ctx0, il);
+
+        const int64_t n_kv  = k->ne[2];
+        const int64_t n_sel = top_k->ne[0];
+        const int64_t n_pad = GGML_PAD(n_sel, 256); // FATTN_KQ_STRIDE: the vector kernel takes whole strides
+
+        const bool v_trans = v->nb[1] > v->nb[2];
+        const bool gather  = cparams.flash_attn && q_cur->ne[2] == 1 && k->ne[3] == 1 && !v_trans &&
+            (ggml_is_quantized(k->type) || ggml_is_quantized(v->type)) && n_pad < n_kv &&
+            k->nb[2] == k->ne[1]*k->nb[1] && v->nb[2] == v->ne[1]*v->nb[1];
+
+        if (gather) {
+            ggml_tensor * idx = ggml_reshape_1d(ctx0, top_k, n_sel);
+
+            // one cache cell per row, dequantized to f32 by get_rows; the padding rows are zero and masked
+            auto gather_cells = [&](ggml_tensor * t) {
+                ggml_tensor * rows = ggml_view_2d(ctx0, t, t->ne[0]*t->ne[1], t->ne[2], t->nb[2], 0);
+                rows = ggml_get_rows(ctx0, rows, idx);
+                if (n_pad > n_sel) {
+                    rows = ggml_pad(ctx0, rows, 0, n_pad - n_sel, 0, 0);
+                }
+                rows = ggml_cast(ctx0, rows, GGML_TYPE_F16);
+                return ggml_reshape_4d(ctx0, rows, t->ne[0], t->ne[1], n_pad, 1);
+            };
+
+            // the query's mask row at the same cells keeps what the cache masks; padding is -inf
+            ggml_tensor * m = ggml_view_2d(ctx0, kq_mask, 1, n_kv, ggml_element_size(kq_mask), 0);
+            m = ggml_reshape_1d(ctx0, ggml_get_rows(ctx0, m, idx), n_sel);
+            if (n_pad > n_sel) {
+                ggml_tensor * m_pad = ggml_fill(ctx0, ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, n_pad - n_sel), -INFINITY);
+                m = ggml_concat(ctx0, m, m_pad, 0);
+            }
+            m = ggml_reshape_4d(ctx0, ggml_cast(ctx0, m, GGML_TYPE_F16), n_pad, 1, 1, 1);
+            cb(m, "kq_mask_gathered", il);
+
+            ggml_tensor * cur = build_attn_mha(q_cur, gather_cells(k), gather_cells(v), nullptr, m, nullptr, nullptr, 0, kq_scale, il);
+            cb(cur, "kqv_out", il);
+
+            if (inp->self_v_rot) {
+                cur = llama_mul_mat_hadamard(ctx0, cur, inp->self_v_rot);
+            }
+
+            return cur;
+        }
+    }
+
     // prepare new kq mask - starts filled with -INFINITY
     ggml_tensor * kq_mask_all = ggml_fill(ctx0, kq_mask, -INFINITY);
 
