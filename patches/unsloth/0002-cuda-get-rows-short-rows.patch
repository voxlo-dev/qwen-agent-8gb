From 7e455759f876e287984608f9b20c6c97005e3bf0 Mon Sep 17 00:00:00 2001
From: voxlo-dev <125759415+voxlo-dev@users.noreply.github.com>
Date: Fri, 16 Oct 2026 17:17:30 +0200
Subject: [PATCH 2/2] cuda: get_rows packs short rows into one block

k_get_rows and k_get_rows_float launch one 256-thread block per row. For
rows shorter than the block most threads idle: the qwen4exp indexer
expands one score per cache cell, n_kv rows of a single float, which
became n_kv blocks of one active thread (0.35 ms per call at 64k).

Size blockDim.x to the row (two values per thread for the quantized
kernel) and fill the block with blockDim.y rows. Rows of 256 values or
more launch as before. test-backend-ops -o GET_ROWS: 216/216 pass.

Qwen3.8-Flash-Next at 64k of depth, with the decode gather: get_rows per
token 7.5 -> 2.5 ms, GPU time per token 33.5 -> 28.5 ms.
---
 ggml/src/ggml-cuda/getrows.cu | 46 ++++++++++++++++++++++++++---------
 1 file changed, 34 insertions(+), 12 deletions(-)

diff --git a/ggml/src/ggml-cuda/getrows.cu b/ggml/src/ggml-cuda/getrows.cu
index 6b36b8f..5873b78 100644
--- a/ggml/src/ggml-cuda/getrows.cu
+++ b/ggml/src/ggml-cuda/getrows.cu
@@ -6,16 +6,21 @@ template<int qk, int qr, dequantize_kernel_t dequantize_kernel, typename dst_t>
 static __global__ void k_get_rows(
         const void * __restrict__ src0, const int32_t * __restrict__ src1, dst_t * __restrict__ dst,
         const int64_t ne00, /*const int64_t ne01, const int64_t ne02, const int64_t ne03,*/
-        /*const int64_t ne10,*/ const int64_t ne11, const uint3 ne12_fdv, /*const int64_t ne13,*/
+        const int64_t ne10, const int64_t ne11, const uint3 ne12_fdv, /*const int64_t ne13,*/
         /*const size_t s0,*/ const size_t s1, const size_t s2, const size_t s3,
         /*const size_t nb00,*/ const size_t nb01, const size_t nb02, const size_t nb03,
         const size_t s10, const size_t s11, const size_t s12/*, const size_t s13*/) {
 
     ggml_cuda_pdl_sync();
+    // short rows share a block: blockDim.y rows of blockDim.x threads each
+    const int64_t i10_blk = (int64_t) blockIdx.x*blockDim.y + threadIdx.y;
+    if (i10_blk >= ne10) {
+        return;
+    }
     for (int64_t z = blockIdx.z; z < ne11*(int64_t)ne12_fdv.z; z += gridDim.z) {
         for (int64_t i00 = 2*(blockIdx.y*blockDim.x + threadIdx.x); i00 < ne00; i00 += gridDim.y*blockDim.x) {
             // The x and y dimensions of the grid are swapped because the maximum allowed grid size for x is higher.
-            const int i10 =  blockIdx.x;
+            const int i10 =  i10_blk;
             const uint2 dm  = fast_div_modulo((uint32_t)z, ne12_fdv);
             const int i11 =  dm.x;
             const int i12 =  dm.y;
@@ -73,7 +78,7 @@ template<typename src0_t, typename dst_t>
 static __global__ void k_get_rows_float(
         const src0_t * src0_ptr, const int32_t * src1_ptr, dst_t * dst_ptr,
         const int64_t ne00, /*const int64_t ne01, const int64_t ne02, const int64_t ne03,*/
-        /*const int64_t ne10,*/ const int64_t ne11, const uint3 ne12_fdv, /*const int64_t ne13,*/
+        const int64_t ne10, const int64_t ne11, const uint3 ne12_fdv, /*const int64_t ne13,*/
         /*const size_t s0,*/ const size_t s1, const size_t s2, const size_t s3,
         /*const size_t nb00,*/ const size_t nb01, const size_t nb02, const size_t nb03,
         const size_t s10, const size_t s11, const size_t s12/*, const size_t s13*/) {
@@ -83,9 +88,14 @@ static __global__ void k_get_rows_float(
     const int32_t * GGML_CUDA_RESTRICT src1 = src1_ptr;
     dst_t         * GGML_CUDA_RESTRICT dst  = dst_ptr;
     ggml_cuda_pdl_sync();
+    // short rows share a block: blockDim.y rows of blockDim.x threads each
+    const int64_t i10_blk = (int64_t) blockIdx.x*blockDim.y + threadIdx.y;
+    if (i10_blk >= ne10) {
+        return;
+    }
     for (int64_t z = blockIdx.z; z < ne11*(int64_t)ne12_fdv.z; z += gridDim.z) {
         // The x and y dimensions of the grid are swapped because the maximum allowed grid size for x is higher.
-        const int i10 = blockIdx.x;
+        const int i10 = i10_blk;
         const uint2 dm = fast_div_modulo((uint32_t)z, ne12_fdv);
         const int i11 = dm.x;
         const int i12 = dm.y;
@@ -163,9 +173,15 @@ static void get_rows_cuda_q(
         const int64_t ne10, const int64_t ne11, const int64_t ne12, const size_t nb10, const size_t nb11, const size_t nb12,
         const size_t nb1, const size_t nb2, const size_t nb3,
         cudaStream_t stream) {
-    const dim3 block_dims(CUDA_GET_ROWS_BLOCK_SIZE, 1, 1);
-    const int block_num_y = (ne00 + 2*CUDA_GET_ROWS_BLOCK_SIZE - 1) / (2*CUDA_GET_ROWS_BLOCK_SIZE);
-    const dim3 block_nums(ne10, MIN(block_num_y, UINT16_MAX), MIN(ne11*ne12, UINT16_MAX));
+    // two values per thread; a row shorter than the block leaves room for more rows
+    int tx = CUDA_GET_ROWS_BLOCK_SIZE;
+    while (tx > 1 && 2*(tx/2) >= ne00) {
+        tx /= 2;
+    }
+    const int ty = CUDA_GET_ROWS_BLOCK_SIZE/tx;
+    const dim3 block_dims(tx, ty, 1);
+    const int block_num_y = (ne00 + 2*tx - 1) / (2*tx);
+    const dim3 block_nums((ne10 + ty - 1)/ty, MIN(block_num_y, UINT16_MAX), MIN(ne11*ne12, UINT16_MAX));
 
     // strides in elements
     // const size_t s0 = nb0 / sizeof(dst_t);
@@ -187,7 +203,7 @@ static void get_rows_cuda_q(
     k_get_rows<qk, qr, dq><<<block_nums, block_dims, 0, stream>>>(
         src0_d, src1_d, dst_d,
         ne00, /*ne01, ne02, ne03,*/
-        /*ne10,*/ ne11, ne12_fdv, /*ne13,*/
+        ne10, ne11, ne12_fdv, /*ne13,*/
         /* s0,*/ s1, s2, s3,
         /* nb00,*/ nb01, nb02, nb03,
         s10, s11, s12/*, s13*/);
@@ -279,14 +295,20 @@ static void get_rows_cuda_float(
         }
     }
 
-    const int block_num_y = (ne00 + CUDA_GET_ROWS_BLOCK_SIZE - 1) / CUDA_GET_ROWS_BLOCK_SIZE;
-    const dim3 block_nums(ne10, MIN(block_num_y, UINT16_MAX), MIN(ne11*ne12, UINT16_MAX));
+    // a row shorter than the block leaves room for more rows: the indexer expands one score per cell
+    int tx = CUDA_GET_ROWS_BLOCK_SIZE;
+    while (tx > 1 && tx/2 >= ne00) {
+        tx /= 2;
+    }
+    const int ty = CUDA_GET_ROWS_BLOCK_SIZE/tx;
+    const int block_num_y = (ne00 + tx - 1) / tx;
+    const dim3 block_nums((ne10 + ty - 1)/ty, MIN(block_num_y, UINT16_MAX), MIN(ne11*ne12, UINT16_MAX));
 
-    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params{block_nums, block_dims, 0, stream};
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params{block_nums, dim3(tx, ty, 1), 0, stream};
     ggml_cuda_kernel_launch(k_get_rows_float<src0_t, dst_t>, launch_params,
         src0_d, src1_d, dst_d,
         ne00, /*ne01, ne02, ne03,*/
-        /*ne10,*/ ne11, ne12_fdv, /*ne13,*/
+        ne10, ne11, ne12_fdv, /*ne13,*/
         /* s0,*/ s1, s2, s3,
         /* nb00,*/ nb01, nb02, nb03,
         s10, s11, s12/*, s13*/);
