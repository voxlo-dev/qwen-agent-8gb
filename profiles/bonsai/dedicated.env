# Profile "dedicated": the GPU drives no display, so all 8 GB are available.
# 64k window, measured at 7 747 MiB of 8 188. See docs/agent.md#context-budget.
: "${CTX:=64000}"
: "${BUDGET:=8192}"
: "${MAX_TOKENS:=16000}"
: "${RESERVE_TOKENS:=16000}"
: "${KEEP_RECENT_TOKENS:=12000}"
