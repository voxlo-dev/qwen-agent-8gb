# SPDX-License-Identifier: MIT
# Qwen3.6-35B-A3B, profile "display": the GPU also renders a desktop, which takes 0.5-1.2 GB.
# The dedicated window with every expert in RAM: ~6 430 MiB by arithmetic (one expert layer is
# ~470 MiB), which leaves ~1 GB. Not measured with a desktop on the card. See docs/qwen36.md.
: "${CTX:=131072}"
: "${CPU_MOE:=40}"
: "${UB:=2048}"
: "${BUDGET:=16384}"
: "${MAX_TOKENS:=32000}"
: "${RESERVE_TOKENS:=32000}"
: "${KEEP_RECENT_TOKENS:=24000}"
