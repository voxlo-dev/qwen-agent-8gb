# SPDX-License-Identifier: MIT
# Qwen3.8-Flash-Next, profile "display": the GPU also renders a desktop, which takes 0.5-1.2 GB.
# Half the dedicated window: 6 052 MiB of buffers, which leaves ~1.6 GB for the desktop. Not
# measured with a desktop on the card. See
# docs/qwen.md#qwen38-flash-125b-experimental.
: "${CTX:=65536}"
: "${CPU_MOE:=48}"
: "${UB:=512}"
: "${BUDGET:=8192}"
: "${MAX_TOKENS:=16000}"
: "${RESERVE_TOKENS:=16000}"
: "${KEEP_RECENT_TOKENS:=12000}"
