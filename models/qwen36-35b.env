# SPDX-License-Identifier: MIT
# Qwen3.6-35B-A3B, a MoE with 3B active parameters: the experts of CPU_MOE layers in system RAM,
# attention, shared expert, KV cache and the MTP head on the card. Experimental: measured for speed
# and KV quality, and in one agent session. Needs ~28 GB RAM; measured on CUDA and, for speed only, on the RX 570. See docs/qwen36.md.
# Sourced by config.env after the profile, so a profile value wins over the defaults here.

# Not the fork: it runs this model as fast but cannot draft with its MTP layer, which is worth
# +33-54 % on natural output. On CUDA, Unsloth's tree, the one Qwen3.8-Flash needs: the same pin
# as models/qwen38-flash.env, and both share its build dir, so move them together. Measured equal to
# mainline 8212c78 to 0.5 %, the same drafts accepted, the same VRAM (T-038). On Vulkan mainline,
# where Qwen3.6 was measured and Unsloth's tree was not. No patches apply to either.
if [ "$BACKEND" = cuda ]; then
  : "${LLAMA_REPO:=https://github.com/unslothai/llama.cpp}"
  : "${LLAMA_COMMIT:=a3c12db9dfc9a5bdf93df199ec370e9faf117c69}"
  : "${LLAMA_TARBALL:=$LLAMA_REPO/releases/download/b11160-mix-a6922cc/llama.cpp-source-commit-$LLAMA_COMMIT.tar.gz}"
  : "${LLAMA_TARBALL_SHA256:=cbd0e8c756da5b2f46df4ddacded46c7733316c44d86a1a5d176fe3ade7b0675}"
  : "${LLAMA_DIR:=$BONSAI_HOME/llama.cpp-unsloth}"
else
  : "${LLAMA_REPO:=https://github.com/ggml-org/llama.cpp}"
  : "${LLAMA_COMMIT:=8212c7802455255460ab8e18fc34754560031b34}"
  : "${LLAMA_DIR:=$BONSAI_HOME/llama.cpp-mainline}"
fi
PATCH_DIR=""

# The -MTP- repo: the same weights as unsloth/Qwen3.6-35B-A3B-GGUF plus one MTP layer.
: "${MODEL_REPO:=unsloth/Qwen3.6-35B-A3B-MTP-GGUF}"
: "${MODEL_REV:=5bc3e238d916f48a861bac2f8a1990a0e9b7e98d}"
: "${MODEL_FILE:=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf}"
: "${MODEL_SHA256:=0b21525e972670ed59e1812e170b27c26355381f0656ecc4e25617ece7dac58b}"
: "${MODEL_ALIAS:=qwen3.6-35b-a3b}"
# RSS 20-23.5 GB while serving, most of it the mmapped experts as page cache; preflight asks for
# this plus ~2 GB in total, which a 28 GB machine (27.4 GB MemTotal) passes. Vulkan is measured on
# the RX 570, with profiles/qwen36-35b/dedicated-vulkan.env: docs/qwen36.md#on-the-rx-570-vulkan.
MODEL_DISK_MB=21700
MODEL_RAM_MB=24000
MODEL_RAM_FULL_MB=0
MODEL_BACKENDS="cuda vulkan"

# q8_0/q8_0: this cache is 3-33x more sensitive than Bonsai's, and V at q4_0 degrades with depth.
# See docs/context-window.md#kv-cache-quality.
: "${KV_K:=q8_0}"
: "${KV_V:=q8_0}"
# Empty: the template reads enable_thinking, not reasoning_effort, so the flag is not passed.
: "${EFFORT:=}"
# The MTP layer drafts, 63-80 % accepted at the default draft length 3. ~1.66 GB of VRAM,
# already paid for in the profile's CPU_MOE and UB.
: "${SPEC_TYPE:=draft-mtp}"
