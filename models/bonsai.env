# SPDX-License-Identifier: MIT
# Ternary-Bonsai-2-27B in PTQ1_0, all 65 layers on the card: the model for a
# machine without RAM to spare, for simple tasks (docs/agent-sessions.md).
# Sourced by config.env after the profile, so a profile value wins over the defaults here.

# PrismML llama.cpp fork (PTQ1_0/PQ2_0 kernels), pinned to the tested commit. Mainline cannot
# load the file (docs/bonsai.md#model-format). PATCH_DIR is applied to it by build.
: "${LLAMA_REPO:=https://github.com/PrismML-Eng/llama.cpp}"
: "${LLAMA_COMMIT:=1a07bfa5f4144274c8f1c9963821dd9d9a51854b}"
: "${LLAMA_DIR:=$QWEN_HOME/llama.cpp}"
PATCH_DIR="patches/$BACKEND"

# Model, pinned to the tested revision
: "${MODEL_REPO:=prism-ml/Ternary-Bonsai-2-27B-gguf}"
: "${MODEL_REV:=6ed5e12bf84b7a63069882c91dd9e9218647d17b}"
: "${MODEL_FILE:=Ternary-Bonsai-2-27B-PTQ1_0.gguf}"
: "${MODEL_SHA256:=53107f530aa52eb00912263ab1ee29bd199261c87cd7b4ad4ca1318c1fe33ee3}"
: "${MODEL_ALIAS:=bonsai-27b}"
# The vision projector (VISION), from the same revision: Q8_0 reads the screens BF16 reads, encodes
# as fast on the CPU and holds 0.3 GB less. Size and RAM for preflight. See docs/bonsai.md#vision.
: "${MMPROJ_FILE:=Ternary-Bonsai-2-27B-mmproj-Q8_0.gguf}"
: "${MMPROJ_SHA256:=6807ede61d570bb86ba34b756a0fa109edc33668604de867c6ea6d8f1d631903}"
MMPROJ_DISK_MB=600
MMPROJ_RAM_MB=850
# What preflight checks for: the download, and the RAM the model holds while serving beyond
# the ~5.8 GB loading peak - none, since every weight is on the card.
MODEL_DISK_MB=5800
MODEL_RAM_MB=0
MODEL_RAM_FULL_MB=0
MODEL_BACKENDS="cuda vulkan"
# How install.sh and preflight list it among the models (README.md#which-model).
MODEL_TITLE="Ternary-Bonsai-2-27B"
MODEL_ROLE="simple tasks, 36 tok/s"
# Where its pin, settings and backends are explained; preflight names it.
MODEL_DOC="docs/bonsai.md"

# K at q8_0 and V at q4_0, measured against f16: 99.66 % same top token at 16k, 510 of 512 at
# 92k. 96k fits at q4_0/q4_0. See docs/context-window.md.
: "${KV_K:=q8_0}"
: "${KV_V:=q4_0}"
# The template's reasoning_effort: low, medium, xhigh (its default). See docs/bonsai.md#reasoning.
: "${EFFORT:=medium}"
# Speculative decoding: none. n-gram types lose on real turns, and this GGUF has no MTP head.
# See docs/performance.md#speculative-decoding-tried-rejected.
: "${SPEC_TYPE:=}"
